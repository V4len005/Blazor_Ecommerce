@inject TiendaJs Js

<button type="button"
        class="btn btn-outline-secondary"
        @onclick="AlternarModo"
        aria-pressed="@(modoOscuro ? "true" : "false")"
        aria-label="@(modoOscuro ? "Activar modo claro" : "Activar modo oscuro")"
        title="@(modoOscuro ? "Activar modo claro" : "Activar modo oscuro")">
    <i class="bi @(modoOscuro ? "bi-sun-fill" : "bi-moon-stars-fill")" aria-hidden="true"></i>
</button>

@code {
    private bool modoOscuro;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            modoOscuro = await Js.ObtenerModoOscuro();
            await Js.AplicarModoOscuro(modoOscuro);
            StateHasChanged();
        }
        catch (Exception)
        {
            // El modo oscuro es una comodidad: si falla, la página se ve en modo claro.
        }
    }

    private async Task AlternarModo()
    {
        modoOscuro = !modoOscuro;

        try
        {
            await Js.EstablecerModoOscuro(modoOscuro);
        }
        catch (Exception)
        {
            // Si no se puede guardar, el botón igual cambia de estado en esta sesión.
        }
    }
}
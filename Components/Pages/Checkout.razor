@page "/checkout"
@inject CarritoState CarritoEstado
@inject IPedidoService PedidoServicio
@inject NavigationManager Navegacion

<PageTitle>Finalizar compra | ValTech</PageTitle>

<section aria-labelledby="titulo-checkout">
    <h1 id="titulo-checkout" class="h3 mb-3">Finalizar compra</h1>

    @if (CarritoEstado.EstaVacio && !pedidoConfirmado)
    {
            <div class="text-center py-5">
                <i class="bi bi-cart-x vacio" aria-hidden="true"></i>
                <p class="lead">Tu carrito está vacío, no hay nada para confirmar.</p>
                <a href="catalogo" class="btn btn-primary">Ver catálogo</a>
            </div>
    }
    else
    {
            <div class="row g-4">
                <div class="col-12 col-lg-7">
                    <EditForm Model="modelo" OnValidSubmit="Confirmar">
                        <DataAnnotationsValidator />

                        <fieldset class="card card-body mb-3">
                            <legend>Tus datos</legend>
                            <div class="row g-3">
                                <div class="col-12">
                                    <label for="nombre" class="form-label">Nombre y apellido</label>
                                    <InputText id="nombre" class="form-control" autocomplete="name"
                                               @bind-Value="modelo.NombreCliente" />
                                    <ValidationMessage For="() => modelo.NombreCliente" />
                                </div>

                                <div class="col-12 col-md-6">
                                    <label for="email" class="form-label">Email</label>
                                    <InputText id="email" class="form-control" inputmode="email" autocomplete="email"
                                               @bind-Value="modelo.Email" />
                                    <ValidationMessage For="() => modelo.Email" />
                                </div>

                                <div class="col-12 col-md-6">
                                    <label for="telefono" class="form-label">
                                        Teléfono <span class="text-muted small">(opcional)</span>
                                    </label>
                                    <InputText id="telefono" class="form-control" inputmode="tel" autocomplete="tel"
                                               @bind-Value="modelo.Telefono" />
                                    <ValidationMessage For="() => modelo.Telefono" />
                                </div>
                            </div>
                        </fieldset>

                        <fieldset class="card card-body mb-3">
                            <legend>Entrega</legend>

                            <InputRadioGroup @bind-Value="modelo.Entrega">
                                <div class="form-check">
                                    <InputRadio id="entrega-retiro" class="form-check-input" Value="TipoEntrega.Retiro" />
                                    <label for="entrega-retiro" class="form-check-label">Retiro en el local</label>
                                </div>
                                <div class="form-check">
                                    <InputRadio id="entrega-domicilio" class="form-check-input" Value="TipoEntrega.Domicilio" />
                                    <label for="entrega-domicilio" class="form-check-label">Envío a domicilio</label>
                                </div>
                            </InputRadioGroup>

                        @if (modelo.Entrega == TipoEntrega.Domicilio)
                        {
                                    <div class="mt-3">
                                        <label for="direccion" class="form-label">Dirección de entrega</label>
                                        <InputText id="direccion" class="form-control" autocomplete="street-address"
                                                   placeholder="Calle, número y localidad"
                                                   @bind-Value="modelo.DireccionEnvio" />
                                        <ValidationMessage For="() => modelo.DireccionEnvio" />
                                    </div>
                        }

                            <div class="mt-3">
                                <label for="observaciones" class="form-label">
                                    Observaciones <span class="text-muted small">(opcional)</span>
                                </label>
                                <InputTextArea id="observaciones" class="form-control" rows="2"
                                               @bind-Value="modelo.Observaciones" />
                                <ValidationMessage For="() => modelo.Observaciones" />
                            </div>
                        </fieldset>

                        <div class="alert alert-info" role="note">
                            <i class="bi bi-info-circle" aria-hidden="true"></i>
                            <strong>Pago simulado:</strong> al confirmar no se realiza ningún cobro.
                        </div>

                        <AlertError Mensaje="@errorConfirmacion" OnCerrar="CerrarError" />

                    @if (errorConfirmacion is not null)
                    {
                                <p class="small">
                                    <a href="carrito">Volver al carrito</a> para revisar las cantidades.
                                </p>
                    }

                        <div class="acciones">
                            <a href="carrito" class="btn btn-outline-secondary">Volver al carrito</a>
                            <button type="submit" class="btn btn-primary" disabled="@guardando">
                            @if (guardando)
                            {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                        <span>Confirmando...</span>
                            }
                            else
                            {
                                        <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        <span>Confirmar pedido</span>
                            }
                            </button>
                        </div>
                    </EditForm>
                </div>

                <aside class="col-12 col-lg-5" aria-labelledby="titulo-resumen">
                    <div class="card card-body resumen">
                        <h2 id="titulo-resumen" class="h5">Resumen del pedido</h2>

                        <ul class="list-unstyled mb-3">
                        @foreach (var item in CarritoEstado.Items)
                        {
                                    <li class="d-flex justify-content-between gap-2 py-1" @key="item.ProductoId">
                                        <span>@item.Cantidad × @item.Nombre</span>
                                        <span class="text-nowrap">@Formato.Precio(item.Subtotal)</span>
                                    </li>
                        }
                        </ul>

                        <dl class="d-flex justify-content-between mb-1">
                            <dt>Total estimado</dt>
                            <dd class="mb-0 total">@Formato.Precio(CarritoEstado.Total)</dd>
                        </dl>

                        <p class="small text-muted mb-0">
                            El total final se calcula al confirmar, con los precios y el stock vigentes.
                        </p>
                    </div>
                </aside>
            </div>
    }
</section>

@code {
    private CheckoutFormulario modelo = new();
    private bool guardando;
    private bool pedidoConfirmado;
    private string? errorConfirmacion;

    private async Task Confirmar()
    {
        guardando = true;
        errorConfirmacion = null;

        try
        {
            // Solo viajan producto y cantidad: el precio y el total los decide el servidor.
            var lineas = CarritoEstado.Items
                .Select(i => new LineaPedido(i.ProductoId, i.Cantidad))
                .ToList();

            var solicitud = new SolicitudPedido(
                modelo.NombreCliente,
                modelo.Email,
                modelo.Telefono,
                modelo.Entrega == TipoEntrega.Domicilio ? modelo.DireccionEnvio : null,
                modelo.Observaciones,
                lineas);

            var pedido = await PedidoServicio.ConfirmarPedido(solicitud);

            // El carrito se vacía solo cuando el servidor confirmó el pedido.
            pedidoConfirmado = true;
            CarritoEstado.Vaciar();

            Navegacion.NavigateTo($"pedido/{pedido.Id}");
        }
        catch (InvalidOperationException ex)
        {
            errorConfirmacion = ex.Message;
        }
        catch (Exception)
        {
            errorConfirmacion = "No se pudo confirmar el pedido. Intentá de nuevo en unos minutos.";
        }
        finally
        {
            guardando = false;
        }
    }

    private void CerrarError() => errorConfirmacion = null;
}
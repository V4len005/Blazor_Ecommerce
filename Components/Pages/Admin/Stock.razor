@page "/admin/stock"
@inject IProductoService ProductoServicio

<PageTitle>Stock | Administración</PageTitle>

<section aria-labelledby="titulo-stock">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 id="titulo-stock" class="h3 mb-0">Stock</h1>
    </header>

    <AlertError Mensaje="@mensajeError" OnCerrar="CerrarError" />

    <form class="card card-body mb-3" role="search" aria-label="Filtrar stock"
          @onsubmit="Buscar" @onsubmit:preventDefault>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5">
                <label for="stock-texto" class="form-label">Buscar</label>
                <input id="stock-texto" type="search" class="form-control"
                       placeholder="Nombre, marca o SKU"
                       @bind="textoBusqueda" @bind:event="oninput" />
            </div>

            <div class="col-12 col-md-4">
                <div class="form-check form-switch">
                    <input id="solo-bajo" type="checkbox" class="form-check-input" @bind="soloStockBajo" />
                    <label for="solo-bajo" class="form-check-label">Solo stock bajo o agotado</label>
                </div>
            </div>

            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search" aria-hidden="true"></i> Buscar
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
            </div>
        </div>
    </form>

    @if (cargando)
    {
            <div class="text-center py-5" role="status">
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <span class="visually-hidden">Cargando stock...</span>
            </div>
    }
    else
    {
            <p class="text-muted small mb-2" aria-live="polite">
                Mostrando @resultado.Items.Count de @resultado.TotalRegistros producto(s)
            </p>

        @if (resultado.Items.Count == 0)
        {
                    <div class="alert alert-info" role="status">No se encontraron productos con esos filtros.</div>
        }
        else
        {
                    <div class="table-responsive contenedor-tabla">
                        <table class="table tabla-admin align-middle">
                            <caption class="visually-hidden">Stock de los productos</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Producto</th>
                                    <th scope="col" class="d-none d-md-table-cell">Categoría</th>
                                    <th scope="col" class="text-center">Stock</th>
                                    <th scope="col" class="text-center d-none d-md-table-cell">Mínimo</th>
                                    <th scope="col">Estado</th>
                                    <th scope="col"><span class="visually-hidden">Acciones</span></th>
                                </tr>
                            </thead>
                            <tbody>
                        @foreach (var p in resultado.Items)
                        {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold">@p.Nombre</div>
                                                <div class="small text-muted">@p.Marca@(string.IsNullOrWhiteSpace(p.Sku) ? "" : $" · {p.Sku}")</div>
                                            </td>
                                            <td class="d-none d-md-table-cell">@(p.Categoria?.Nombre)</td>
                                            <td class="text-center">@p.StockActual</td>
                                            <td class="text-center d-none d-md-table-cell">@p.StockMinimo</td>
                                            <td><BadgeStock StockActual="p.StockActual" StockMinimo="p.StockMinimo" /></td>
                                            <td class="text-end">
                                                <a href="admin/stock/@p.Id/movimiento" class="btn btn-sm btn-outline-primary"
                                                   aria-label="Registrar movimiento de @p.Nombre" title="Registrar movimiento">
                                                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                                </a>
                                            </td>
                                        </tr>
                        }
                            </tbody>
                        </table>
                    </div>
        }

            <div class="mt-3">
                <Paginacion PaginaActual="resultado.Pagina"
                            TotalPaginas="resultado.TotalPaginas"
                            OnCambio="CambiarPagina" />
            </div>
    }
</section>

@code {
    private const int TamanioPagina = 10;

    private ResultadoPaginado<Producto> resultado = new();

    private string textoBusqueda = string.Empty;
    private bool soloStockBajo;
    private int paginaActual = 1;

    private bool cargando = true;
    private string? mensajeError;

    protected override async Task OnInitializedAsync() => await CargarProductos();

    private async Task CargarProductos()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            resultado = await ProductoServicio.ObtenerPaginado(
                textoBusqueda, null, paginaActual, TamanioPagina, soloStockBajo: soloStockBajo);

            paginaActual = resultado.Pagina;
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar el stock. Intentá de nuevo en unos minutos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task Buscar()
    {
        paginaActual = 1;
        await CargarProductos();
    }

    private async Task Limpiar()
    {
        textoBusqueda = string.Empty;
        soloStockBajo = false;
        paginaActual = 1;
        await CargarProductos();
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        paginaActual = nuevaPagina;
        await CargarProductos();
    }

    private void CerrarError() => mensajeError = null;
}
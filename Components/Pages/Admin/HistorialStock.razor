@page "/admin/stock/historial"
@inject IStockService StockServicio
@inject IProductoService ProductoServicio
@inject NavigationManager Navegacion

<PageTitle>Historial de stock | Administración</PageTitle>

<section aria-labelledby="titulo-historial">
    <header class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h1 id="titulo-historial" class="h3 mb-0">Historial de movimientos</h1>
        <a href="admin/stock" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left" aria-hidden="true"></i> Volver al stock
        </a>
    </header>

    <AlertError Mensaje="@mensajeError" OnCerrar="CerrarError" />

    @if (ProductoId is not null)
    {
            <p>
                <a href="@Enlace(null, TipoFiltro?.ToString(), MotivoFiltro?.ToString())"
                   class="btn btn-sm btn-outline-secondary">
                    Producto: @(nombreProducto ?? $"#{ProductoId}") <i class="bi bi-x-lg" aria-hidden="true"></i>
                    <span class="visually-hidden">Quitar filtro de producto</span>
                </a>
            </p>
    }

    <form class="card card-body mb-3" aria-label="Filtrar movimientos"
          @onsubmit="Filtrar" @onsubmit:preventDefault>
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-4">
                <label for="filtro-tipo" class="form-label">Tipo</label>
                <select id="filtro-tipo" class="form-select" @bind="tipoSeleccionado">
                    <option value="">Todos</option>
                    @foreach (var tipo in Enum.GetValues<TipoMovimiento>())
                    {
                            <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-4">
                <label for="filtro-motivo" class="form-label">Motivo</label>
                <select id="filtro-motivo" class="form-select" @bind="motivoSeleccionado">
                    <option value="">Todos</option>
                    @foreach (var motivo in Enum.GetValues<MotivoMovimiento>())
                    {
                            <option value="@motivo">@Formato.Motivo(motivo)</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-funnel" aria-hidden="true"></i> Filtrar
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="Limpiar">Limpiar</button>
            </div>
        </div>
    </form>

    @if (cargando)
    {
            <div class="text-center py-5" role="status">
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <span class="visually-hidden">Cargando historial...</span>
            </div>
    }
    else
    {
            <p class="text-muted small mb-2" aria-live="polite">
                Mostrando @resultado.Items.Count de @resultado.TotalRegistros movimiento(s)
            </p>

        @if (resultado.Items.Count == 0)
        {
                    <div class="alert alert-info" role="status">No hay movimientos con esos filtros.</div>
        }
        else
        {
                    <div class="table-responsive contenedor-tabla">
                        <table class="table tabla-admin align-middle">
                            <caption class="visually-hidden">Historial de movimientos de stock</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Fecha</th>
                                    <th scope="col">Producto</th>
                                    <th scope="col" class="d-none d-md-table-cell">Tipo</th>
                                    <th scope="col" class="d-none d-md-table-cell">Motivo</th>
                                    <th scope="col" class="text-end">Cantidad</th>
                                    <th scope="col" class="d-none d-lg-table-cell">Observación</th>
                                </tr>
                            </thead>
                            <tbody>
                        @foreach (var m in resultado.Items)
                        {
                                        <tr>
                                            <td class="text-nowrap">@Formato.FechaHora(m.Fecha)</td>
                                            <td>
                                                <div class="fw-semibold">@(m.Producto?.Nombre)</div>
                                                <div class="small text-muted d-md-none">@m.Tipo · @Formato.Motivo(m.Motivo)</div>
                                            </td>
                                            <td class="d-none d-md-table-cell">@m.Tipo</td>
                                            <td class="d-none d-md-table-cell">@Formato.Motivo(m.Motivo)</td>
                                            <td class="text-end text-nowrap fw-semibold @(m.Variacion >= 0 ? "text-success" : "text-danger")">
                                    @Formato.Variacion(m.Variacion)
                                            </td>
                                            <td class="d-none d-lg-table-cell">@m.Observacion</td>
                                        </tr>
                        }
                            </tbody>
                        </table>
                    </div>
        }

            <div class="mt-3">
                <Paginacion PaginaActual="resultado.Pagina"
                            TotalPaginas="resultado.TotalPaginas"
                            OnCambio="CambiarPagina" />
            </div>
    }
</section>

@code {
    private const int TamanioPagina = 10;

    /// <summary>Producto filtrado, tomado de la URL (?producto=...).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "producto")]
    public int? ProductoId { get; set; }

    /// <summary>Tipo filtrado, tomado de la URL (?tipo=...). Llega como texto.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tipo")]
    public string? Tipo { get; set; }

    /// <summary>Motivo filtrado, tomado de la URL (?motivo=...). Llega como texto.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "motivo")]
    public string? Motivo { get; set; }

    /// <summary>Página pedida, tomada de la URL (?pagina=...).</summary>
    [Parameter, SupplyParameterFromQuery(Name = "pagina")]
    public int? Pagina { get; set; }

    private ResultadoPaginado<MovimientoStock> resultado = new();

    private string tipoSeleccionado = string.Empty;
    private string motivoSeleccionado = string.Empty;
    private string? nombreProducto;

    private bool cargando = true;
    private string? mensajeError;
    private string? claveCargada;

    // Convierten el texto de la URL en enum; un valor inválido se ignora (no filtra).
    private TipoMovimiento? TipoFiltro =>
        Enum.TryParse<TipoMovimiento>(Tipo, true, out var tipo) && Enum.IsDefined(tipo) ? tipo : null;

    private MotivoMovimiento? MotivoFiltro =>
        Enum.TryParse<MotivoMovimiento>(Motivo, true, out var motivo) && Enum.IsDefined(motivo) ? motivo : null;

    protected override async Task OnParametersSetAsync()
    {
        // Evita consultar de nuevo si la URL no cambió.
        var clave = $"{ProductoId}|{Tipo}|{Motivo}|{Pagina}";

        if (clave == claveCargada)
        {
            return;
        }

        claveCargada = clave;

        tipoSeleccionado = TipoFiltro?.ToString() ?? string.Empty;
        motivoSeleccionado = MotivoFiltro?.ToString() ?? string.Empty;

        await CargarNombreProducto();
        await CargarHistorial();
    }

    private async Task CargarNombreProducto()
    {
        nombreProducto = null;

        if (ProductoId is null)
        {
            return;
        }

        try
        {
            nombreProducto = (await ProductoServicio.ObtenerPorId(ProductoId.Value))?.Nombre;
        }
        catch (Exception)
        {
            // Si falla, el filtro muestra el número de producto en lugar del nombre.
        }
    }

    private async Task CargarHistorial()
    {
        cargando = true;
        mensajeError = null;

        try
        {
            resultado = await StockServicio.ObtenerHistorial(
                ProductoId, TipoFiltro, MotivoFiltro, Pagina ?? 1, TamanioPagina);
        }
        catch (Exception)
        {
            mensajeError = "No se pudo cargar el historial. Intentá de nuevo en unos minutos.";
        }
        finally
        {
            cargando = false;
        }
    }

    // Arma la URL del historial con los filtros indicados. Un valor null o vacío quita ese parámetro.
    private string Enlace(int? producto, string? tipo, string? motivo, int? pagina = null) =>
        Navegacion.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["producto"] = producto,
                ["tipo"] = string.IsNullOrEmpty(tipo) ? null : tipo,
                ["motivo"] = string.IsNullOrEmpty(motivo) ? null : motivo,
                ["pagina"] = pagina
            });

    private void Filtrar() =>
        Navegacion.NavigateTo(Enlace(ProductoId, tipoSeleccionado, motivoSeleccionado));

    private void Limpiar() =>
        Navegacion.NavigateTo(Enlace(ProductoId, null, null));

    private void CambiarPagina(int nuevaPagina) =>
        Navegacion.NavigateTo(Enlace(
            ProductoId, TipoFiltro?.ToString(), MotivoFiltro?.ToString(), nuevaPagina == 1 ? null : nuevaPagina));

    private void CerrarError() => mensajeError = null;
}